# Instalacao reprodutivel e sem execucao de codigo de terceiros (tecnica/08 §4.8).

# O lockfile e a verdade. Se o manifesto divergir, a instalacao falha em vez de
# reescrever o lockfile em silencio.
frozen-lockfile=true

# Nenhum pacote corre `preinstall`/`postinstall` na nossa maquina nem no CI. Foi
# por scripts de instalacao que varios ataques de cadeia de abastecimento
# passaram; o incidente do LiteLLM (E4 §2.7) e o caso-referencia.
#
# ATENCAO: esta opcao **nao** impede a execucao de `.pnpmfile.cjs`/`.pnpmfile.mjs`
# (documentacao do pnpm). Por isso `lint_arch structure` recusa a existencia
# desses ficheiros no repositorio: seriam uma saida de emergencia desta regra.
ignore-scripts=true

# `error`, nao o `install` que e o default: um `pnpm run` sobre uma arvore
# desactualizada tem de falhar, nao instalar por sua iniciativa.
verify-deps-before-run=error

# Versoes exactas nos manifestos. O Renovate esta configurado com
# `rangeStrategy: "pin"` e espera o mesmo deste lado.
save-exact=true

# Recusa instalar com um Node fora do `engines` (Node 24 LTS).
engine-strict=true
