{
  "name": "@kamba/core-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca TypeScript partilhada pelos servicos Node (KAM-001)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./secrets": {
      "types": "./dist/secrets/index.d.ts",
      "default": "./dist/secrets/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./tenant_guard": {
      "types": "./dist/tenant_guard/index.d.ts",
      "default": "./dist/tenant_guard/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./eventos": {
      "types": "./dist/eventos/index.d.ts",
      "default": "./dist/eventos/index.js"
    },
    "./eventos/filas_bullmq": {
      "types": "./dist/eventos/filas_bullmq.d.ts",
      "default": "./dist/eventos/filas_bullmq.js"
    },
    "./eventos/trabalhador_bullmq": {
      "types": "./dist/eventos/trabalhador_bullmq.d.ts",
      "default": "./dist/eventos/trabalhador_bullmq.js"
    },
    "./ten": {
      "types": "./dist/ten/index.d.ts",
      "default": "./dist/ten/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@kamba/contracts": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  },
  "types": "./dist/index.d.ts"
}
