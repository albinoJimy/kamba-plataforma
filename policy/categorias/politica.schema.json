{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamba.ao/policy/categorias/politica.schema.json",
  "title": "Politica de categorias do screening (KAM-088)",
  "description": "A forma de policy/categorias/*.yaml. O validador e o de tools/politica_categorias/esquema.py, que recusa qualquer palavra-chave que nao conheca: um esquema que usasse uma e passasse calado validava menos do que diz.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "categorias"],
  "properties": {
    "versao": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "categorias": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decisao",
          "termos",
          "padroes",
          "fonte_meta",
          "fonte_lei",
          "estado_evidencia",
          "revisto_em"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "decisao": {
            "enum": ["permitida", "condicional", "bloqueada"]
          },
          "termos": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "padroes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fonte_meta": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "fonte_lei": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "estado_evidencia": {
            "enum": ["CONFIRMADO", "INDÍCIO", "NÃO VERIFICADO"]
          },
          "revisto_em": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
