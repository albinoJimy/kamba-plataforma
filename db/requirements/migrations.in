asn1crypto==1.5.1          # MIT
python-dateutil==2.9.0.post0  # Apache-2.0 (declara tambem BSD; o leitor toma o primeiro)
six==1.17.0                # MIT
typing-extensions==4.16.0  # PSF-2.0 — mesma versao de tools/requirements/tools.in
