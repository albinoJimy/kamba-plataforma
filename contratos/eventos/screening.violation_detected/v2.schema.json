{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contratos.kamba.ao/eventos/screening.violation_detected/v2.schema.json",
  "title": "screening.violation_detected v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tipo",
    "versao",
    "tenant_id",
    "ocorrido_em",
    "registado_em",
    "produtor",
    "agregado",
    "correlacao_id",
    "causa_id",
    "trace_id",
    "classe_pii",
    "finalidades",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7 do evento. Chave global de idempotencia."
    },
    "tipo": {
      "type": "string",
      "const": "screening.violation_detected"
    },
    "versao": {
      "type": "integer",
      "const": 2
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "ocorrido_em": {
      "type": "string",
      "format": "date-time"
    },
    "registado_em": {
      "type": "string",
      "format": "date-time"
    },
    "produtor": {
      "type": [
        "string",
        "null"
      ]
    },
    "agregado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "id",
        "seq"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "const": "product"
        },
        "id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "correlacao_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causa_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "classe_pii": {
      "type": "string",
      "enum": [
        "P0"
      ]
    },
    "finalidades": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "transacao",
          "atendimento",
          "marketing",
          "analytics_agregado",
          "melhoria_servico",
          "sugestoes_patrocinadas",
          "partilha_loja",
          "partilha_parceiros",
          "partilha_estafeta",
          "notificacao_dono"
        ]
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "regras",
        "versao_politica",
        "sha256"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "regras": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versao_politica": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "O screening_decision.conteudo_sha256 da decisao, em hexadecimal minusculo. Um resumo, e nao o texto do produto."
        }
      }
    }
  }
}
